{
  "openapi": "3.1.0",
  "info": {
    "title": "Reson PC analysis API",
    "version": "1.1.0",
    "description": "Local companion for Reson. Pretrained music AI and a motif composer run on PC; iPhone plays cached tactile arrangements. All endpoints require the bearer token in .pc-server/connection.json. Source and separated audio are temporary; haptic tracks, analysis graphs and AHAP exports persist. Protocol 1 remains compatible with legacy version 2 tracks."
  },
  "servers": [{"url": "http://127.0.0.1:8765", "description": "Same computer. On iPhone use the PC's private LAN address."}],
  "security": [{"connectionKey": []}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check the connection and protocol version",
        "responses": {
          "200": {"description": "Connected", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "Read this API specification",
        "responses": {
          "200": {"description": "OpenAPI 3.1 document", "content": {"application/json": {"schema": {"type": "object"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/jobs": {
      "post": {
        "operationId": "analyzeYouTubeVideo",
        "summary": "Queue a YouTube video for analysis",
        "description": "Requires yt-dlp and a downloadable video of at most 20 minutes. Video availability can change. Up to 8 unfinished jobs, processed one at a time. Poll GET /jobs/{jobID} until done, failed or canceled. Every request fetches and analyzes again, preserving prior results with independent track IDs. Retrieve saved results with GET /tracks/{trackID}.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VideoRequest"}, "example": {"videoID": "BaW_jenozKc", "title": "Example", "style": "following", "profile": "standard"}}}},
        "responses": {
          "202": {"$ref": "#/components/responses/Accepted"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/jobs/upload": {
      "post": {
        "operationId": "analyzeAudioFile",
        "summary": "Upload an audio or video file for analysis",
        "description": "Send raw bytes, not multipart/form-data. Content-Length is required; chunked uploads are unsupported. Limit: 512 MiB, 20 minutes of decoded audio. FFmpeg-supported unprotected files such as WAV, M4A, MP3 and MP4. Metadata goes in headers. Every request analyzes again and preserves prior results with independent track IDs; saved results are retrieved with GET /tracks/{trackID}.",
        "x-upload-max-bytes": 536870912,
        "parameters": [
          {"in": "header", "name": "X-Media-Title", "description": "Base64 of the UTF-8 title. Omit to use the default title.", "schema": {"type": "string", "contentEncoding": "base64"}},
          {"in": "header", "name": "X-Generation-Style", "schema": {"$ref": "#/components/schemas/Style"}},
          {"in": "header", "name": "X-Music-Profile", "schema": {"$ref": "#/components/schemas/Profile"}}
        ],
        "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "202": {"$ref": "#/components/responses/Accepted"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/jobs/{jobID}": {
      "parameters": [{"$ref": "#/components/parameters/JobID"}],
      "get": {
        "operationId": "getJob",
        "summary": "Poll progress and retrieve the completed track",
        "description": "When state is done, track contains the haptic data. Analysis failures are reported as state=failed with HTTP 200. Job IDs exist only for the current server process; saved track IDs survive restart.",
        "responses": {
          "200": {"description": "Job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "delete": {
        "operationId": "cancelJob",
        "summary": "Cancel a queued or running job",
        "description": "Removes temporary source audio. Existing saved tracks are kept.",
        "responses": {
          "200": {"description": "Cancellation requested", "content": {"application/json": {"schema": {"type": "object", "required": ["canceled"], "properties": {"canceled": {"const": true}}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/tracks": {
      "get": {
        "operationId": "listTracks",
        "summary": "List saved haptic tracks, newest first",
        "responses": {
          "200": {"description": "Track metadata", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/TrackMetadata"}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/tracks/{trackID}": {
      "parameters": [{"$ref": "#/components/parameters/TrackID"}],
      "get": {
        "operationId": "getTrack",
        "summary": "Retrieve a saved haptic track, including after server restart",
        "responses": {
          "200": {"description": "Haptic track", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HapticTrack"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      },
      "delete": {
        "operationId": "deleteTrack",
        "summary": "Delete one saved PC track",
        "description": "Idempotent for a valid track ID. Does not delete the copy stored on iPhone.",
        "responses": {
          "200": {"description": "Deleted or already absent", "content": {"application/json": {"schema": {"type": "object", "required": ["deleted"], "properties": {"deleted": {"const": true}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/tracks/{trackID}/ahap": {
      "parameters": [{"$ref": "#/components/parameters/TrackID"}],
      "get": {
        "operationId": "exportAHAPLayers",
        "summary": "Export an AI arrangement as synchronized AHAP clips",
        "description": "Returns a manifest and filename-to-AHAP dictionaries. Play each clip's bed and accents with separate players at the same engine time. Clips are 8 seconds or shorter, with at most 16 points per curve. External audio is played separately. Legacy tracks return 404.",
        "responses": {
          "200": {"description": "Layered AHAP bundle", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AHAPBundle"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/shutdown": {
      "post": {
        "operationId": "stopServer",
        "summary": "Stop the server and cancel unfinished jobs",
        "description": "Saved tracks are kept.",
        "responses": {
          "200": {"description": "Stopping", "content": {"application/json": {"schema": {"type": "object", "required": ["stopping"], "properties": {"stopping": {"const": true}}}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"connectionKey": {"type": "http", "scheme": "bearer", "description": "Generated locally in .pc-server/connection.json. Separate from Apple Account, Google OAuth and YouTube API credentials."}},
    "parameters": {
      "JobID": {"in": "path", "name": "jobID", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "TrackID": {"in": "path", "name": "trackID", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "responses": {
      "Accepted": {"description": "Queued; poll using id", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
      "BadRequest": {"description": "Invalid payload, ID, style, profile, upload size, or queue full", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Missing or incorrect bearer token, or non-local client address", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Unknown job, saved track, or endpoint", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
      "Style": {"type": "string", "enum": ["following", "musical", "arranged"], "default": "following", "description": "arranged: pretrained neural analysis and motif beam search; requires arrangementAvailable=true. following and musical are legacy DSP modes. Default following preserves compatibility; new iPhone requests explicitly send arranged."},
      "Profile": {"type": "string", "enum": ["standard", "orchestral"], "default": "standard", "description": "orchestral keeps natural onsets and smooth sustained dynamics, taking precedence over musical rhythm arrangement."},
      "Level": {"type": "number", "minimum": 0, "maximum": 1},
      "Health": {
        "type": "object", "required": ["protocolVersion", "profile", "youtubeAvailable", "apiVersion", "openapi"],
        "properties": {"protocolVersion": {"const": 1}, "profile": {"type": "string"}, "youtubeAvailable": {"type": "boolean"}, "arrangementAvailable": {"type": "boolean"}, "trackVersions": {"type": "array", "items": {"type": "integer"}}, "apiVersion": {"const": "1.1.0"}, "openapi": {"const": "/openapi.json"}}
      },
      "VideoRequest": {
        "type": "object", "required": ["videoID"],
        "properties": {"videoID": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"}, "title": {"type": "string", "description": "Stored title is truncated to 300 characters.", "default": "YouTube動画"}, "style": {"$ref": "#/components/schemas/Style"}, "profile": {"$ref": "#/components/schemas/Profile"}}
      },
      "Job": {
        "type": "object", "required": ["id", "state", "progress", "message"],
        "properties": {"id": {"type": "string", "format": "uuid"}, "state": {"type": "string", "enum": ["queued", "running", "done", "failed", "canceled"]}, "progress": {"$ref": "#/components/schemas/Level"}, "message": {"type": "string"}, "trackID": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "track": {"$ref": "#/components/schemas/HapticTrack"}},
        "allOf": [{"if": {"properties": {"state": {"const": "done"}}}, "then": {"required": ["trackID", "track"]}}]
      },
      "TrackMetadata": {
        "type": "object", "required": ["id", "title", "duration", "createdAt", "style", "profile"],
        "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "title": {"type": "string"}, "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 1200}, "createdAt": {"type": "number", "description": "Unix time in seconds"}, "videoID": {"type": ["string", "null"]}, "style": {"$ref": "#/components/schemas/Style"}, "profile": {"$ref": "#/components/schemas/Profile"}}
      },
      "EnvelopePoint": {
        "type": "object", "required": ["time", "bass", "energy", "sharpness", "mid", "high"],
        "properties": {"time": {"type": "number", "minimum": 0, "description": "Seconds from the beginning of the audio"}, "bass": {"$ref": "#/components/schemas/Level"}, "energy": {"$ref": "#/components/schemas/Level"}, "sharpness": {"$ref": "#/components/schemas/Level"}, "mid": {"$ref": "#/components/schemas/Level"}, "high": {"$ref": "#/components/schemas/Level"}, "intensity": {"$ref": "#/components/schemas/Level", "description": "Version 3: composed sustained voice. Do not remap from bass/energy."}}
      },
      "Tap": {
        "type": "object", "required": ["time", "intensity", "sharpness"],
        "properties": {"time": {"type": "number", "minimum": 0}, "intensity": {"$ref": "#/components/schemas/Level"}, "sharpness": {"$ref": "#/components/schemas/Level"}, "priority": {"$ref": "#/components/schemas/Level"}, "role": {"enum": ["accent", "groove", "fill"]}}
      },
      "SpectrumFrame": {
        "type": "object", "required": ["time", "levels"],
        "properties": {"time": {"type": "number", "minimum": 0}, "levels": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/components/schemas/Level"}, "description": "24 logarithmic bands from 20 Hz to 8 kHz"}}
      },
      "Analysis": {
        "type": "object", "required": ["engine", "elapsedSeconds", "sampleRate", "hopMilliseconds", "fftSize", "serverTrackID", "style", "profile"],
        "properties": {"engine": {"const": "pc"}, "elapsedSeconds": {"type": "number", "minimum": 0}, "sampleRate": {"const": 44100}, "hopMilliseconds": {"enum": [10, 20]}, "fftSize": {"const": 4096}, "serverTrackID": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "style": {"$ref": "#/components/schemas/Style"}, "tempoBPM": {"type": ["number", "null"]}, "profile": {"$ref": "#/components/schemas/Profile"}, "pipeline": {"type": "string"}, "models": {"type": "object", "additionalProperties": {"type": "string"}}}
      },
      "HapticTrack": {
        "type": "object", "required": ["version", "audioSHA256", "duration", "envelope", "taps", "spectrum", "analysis"],
        "properties": {"version": {"enum": [2, 3]}, "audioSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 1200}, "envelope": {"type": "array", "minItems": 1, "maxItems": 125000, "items": {"$ref": "#/components/schemas/EnvelopePoint"}}, "taps": {"type": "array", "maxItems": 12001, "items": {"$ref": "#/components/schemas/Tap"}}, "spectrum": {"type": "array", "minItems": 1, "maxItems": 125000, "items": {"$ref": "#/components/schemas/SpectrumFrame"}}, "analysis": {"$ref": "#/components/schemas/Analysis"}, "arrangement": {"$ref": "#/components/schemas/Arrangement"}},
        "allOf": [{"if": {"properties": {"version": {"const": 3}}}, "then": {"required": ["arrangement"], "properties": {"envelope": {"items": {"required": ["intensity"]}}}}}]
      },
      "Arrangement": {
        "type": "object", "required": ["version", "sections", "bars", "rhythmAgreement", "rhythmSource"],
        "properties": {
          "version": {"const": 1}, "rhythmAgreement": {"allOf": [{"$ref": "#/components/schemas/Level"}], "description": "Model consistency, not accuracy. arrangement-3.3 uses one-to-one beat F1 within 70 ms; older scores used directional nearest-neighbor agreement."}, "rhythmSource": {"enum": ["all-in-one", "beat-this"]},
          "downbeatAgreement": {"$ref": "#/components/schemas/Level"},
          "rhythmDiagnostics": {"type": "object", "properties": {"agreementMethod": {"type": "string"}, "removedBeats": {"type": "array", "items": {"type": "number", "minimum": 0}}, "beatMatch": {"$ref": "#/components/schemas/RhythmMatch"}, "downbeatMatch": {"$ref": "#/components/schemas/RhythmMatch"}}},
          "sections": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "object", "required": ["id", "start", "end", "label", "confidence", "mood", "family"], "properties": {"id": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "label": {"type": "string"}, "confidence": {"$ref": "#/components/schemas/Level"}, "mood": {"type": "string"}, "family": {"enum": ["drive", "pulse", "sway"]}, "groove": {"$ref": "#/components/schemas/Groove"}}}},
          "bars": {"type": "array", "maxItems": 4000, "items": {"type": "object", "required": ["start", "end", "meter", "sectionID", "motif", "reliable"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}, "meter": {"type": "integer", "minimum": 2, "maximum": 7}, "sectionID": {"type": "string"}, "motif": {"enum": ["sparse", "pulse", "drive", "offbeat", "breath", "rest"]}, "reliable": {"type": "boolean"}}}}
        }
      },
      "RhythmMatch": {
        "type": "object", "required": ["matches", "precision", "recall", "f1"],
        "properties": {"matches": {"type": "integer", "minimum": 0}, "precision": {"$ref": "#/components/schemas/Level"}, "recall": {"$ref": "#/components/schemas/Level"}, "f1": {"$ref": "#/components/schemas/Level"}}
      },
      "Groove": {
        "type": "object", "required": ["kind", "split", "confidence", "observations"],
        "properties": {"kind": {"enum": ["unknown", "straight", "sixteenth-swing"]}, "split": {"type": "number", "minimum": 0.5, "maximum": 0.8}, "confidence": {"$ref": "#/components/schemas/Level"}, "observations": {"type": "integer", "minimum": 0}}
      },
      "AHAPBundle": {
        "type": "object", "required": ["manifest", "files"],
        "properties": {"manifest": {"type": "object", "required": ["version", "duration", "playback", "clips"]}, "files": {"type": "object", "additionalProperties": {"type": "object", "required": ["Version", "Pattern"], "properties": {"Version": {"const": 1}, "Pattern": {"type": "array", "minItems": 1}}}}}
      }
    }
  }
}
